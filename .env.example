# AgentTriad (AaaS) — Cloud-Agnostic Local / Any-VM Environment Configuration
# Copy to `.env` before running `docker compose up --build`

# Ports
CONTROL_PLANE_PORT=8080
DB_AGENT_PORT=8081
INFRA_AGENT_PORT=8082
POSTGRES_PORT=5432
REDIS_PORT=6379

# Local PostgreSQL & Redis (zero cloud dependencies)
POSTGRES_USER=aaas
POSTGRES_PASSWORD=aaas_local_dev_password
POSTGRES_DB=agent_triad

# State, Locking & Telemetry Backends
AAAS_STATE_BACKEND=postgres
AAAS_LOCK_BACKEND=redis
AAAS_TELEMETRY_PROVIDER=otel
AAAS_OTEL_LOKI_URL=
AAAS_PROMETHEUS_ALERTMANAGER_URL=
AAAS_CLOUD_STATUS_MODE=offline

# Target Cloud Strategy (`gcp` | `aws` | `azure`)
CLOUD_PROVIDER=gcp
GCP_PROJECT_ID=agent-triad-local
GCP_REGION=us-central1
AWS_REGION=us-east-1

# Model-Agnostic LLM Routing (`vertex` | `gemini` | `litellm` | `bedrock` | `azure_openai` | `openai`)
# Leave AAAS_LLM_API_KEY blank to run in zero-key deterministic RAG/Playbook local mode,
# or point AAAS_LLM_API_BASE to a local LiteLLM / Ollama OpenAI-compatible proxy (e.g. http://host.docker.internal:4000/v1).
GOOGLE_GENAI_USE_VERTEXAI=FALSE
AAAS_LLM_PROVIDER=openai
AAAS_LLM_MODEL=gpt-4o-mini
AAAS_LLM_API_BASE=
AAAS_LLM_API_KEY=

# Optional Azure OpenAI / AWS Bedrock overrides
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Pluggable OIDC Verification (optional for local mode)
AAAS_AUTH_PROVIDER=oidc
AAAS_OIDC_JWKS_URL=
AAAS_OIDC_ISSUER=
AAAS_OIDC_AUDIENCE=

# Optional Read-Only Database Introspection DSN (`pg_stat_activity`)
AAAS_DB_READONLY_DSN=

# Bidirectional GitOps Reconciliation Repository
AAAS_GITOPS_REPO=harisankar/AgentTriad
AAAS_GITOPS_BASE_BRANCH=main
